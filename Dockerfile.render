# Laravel backend — PHP 8.3 + PostgreSQL (pdo_pgsql)
# Render-compatible version (no --network=host)
FROM php:8.3-cli-alpine

# System dependencies and PHP extensions:
#   pdo_pgsql        — PostgreSQL driver
#   gd               — image processing (medialibrary, intervention/image, dompdf, phpspreadsheet)
#   zip              — archive support (maatwebsite/excel, spatie/laravel-backup)
#   exif             — image metadata (spatie/laravel-medialibrary)
#   pcntl            — process signals (laravel/reverb WebSocket server)
#   nginx            — single public port: routes WebSockets to Reverb, the rest to Laravel
RUN apk add --no-cache \
        nginx \
        libpq-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libzip-dev \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install pdo_pgsql gd zip exif pcntl

# Composer (PHP package manager)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Run as a non-root user
ARG UID=1000
RUN addgroup -g ${UID} -S app && adduser -u ${UID} -S app -G app
USER app

WORKDIR /var/www/html

# Install dependencies at build time
COPY --chown=app:app composer.json composer.lock ./
RUN composer install --prefer-dist --no-progress --no-interaction --no-scripts \
    && composer dump-autoload --optimize --no-scripts

COPY --chown=app:app . .

# Seed .env from .env.example so artisan commands that read the file succeed.
# Render injects real secrets as env vars at runtime, which override these values.
RUN cp .env.example .env

# php artisan serve handles one request at a time by default; a browser that
# opens several parallel calls (or holds a polling connection) queues behind
# it and looks "hung". A small worker pool keeps concurrent API calls moving
# on the 512 MB free instance.
ENV PHP_CLI_SERVER_WORKERS=4

EXPOSE 10000

# Start-up (see deploy/render/start.sh): cache config, migrate, seed on first
# boot, then run the API, Reverb WebSockets, queue worker and scheduler behind
# nginx on Render's $PORT. Without the worker and scheduler, announcements and
# ban expiry never run; without Reverb, nothing is realtime.
CMD ["sh", "deploy/render/start.sh"]
