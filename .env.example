APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Storage timezone. Keep UTC: timestamps are stored without a zone.
APP_TIMEZONE=UTC
# Where the platform operates: provider hours and booking times are read in
# this wall clock (shown read-only in System Settings).
BUSINESS_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=group6_db
DB_USERNAME=group6
DB_PASSWORD=group6secret
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=group6
REVERB_APP_KEY=skillserve-local-key
REVERB_APP_SECRET=skillserve-local-secret
VITE_REVERB_APP_KEY=skillserve-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 1 — Authentication & Authorization
FRONTEND_URL=http://localhost:5173
# Comma-separated production/browser origins. Native mobile apps do not use CORS.
# FRONTEND_URLS=https://admin.example.com
SANCTUM_EXPIRATION=1440
LOGIN_RATE_LIMIT=5
# Per-IP limit (per minute) on mobile sign-up, OTP and password-reset endpoints.
CLIENT_AUTH_RATE_LIMIT=20
ADMIN_EMAIL=admin@skillserve.test
ADMIN_PASSWORD="SkillServe#2026"
L5_SWAGGER_GENERATE_ALWAYS=true

# Set to true to expose the Swagger UI even in production
SWAGGER_UI_ENABLED=false

# Mobile sessions. Access tokens are short-lived and renewed from the refresh
# token; the refresh token window is counted from last use (default: 1 year).
CLIENT_ACCESS_TOKEN_EXPIRATION=60
CLIENT_REFRESH_TOKEN_EXPIRATION=525600
# Minutes the mobile app's read-only background notification token lives.
CLIENT_BACKGROUND_TOKEN_EXPIRATION=525600

# --- PayMongo (GCash) --------------------------------------------------------
# Leave these empty to keep GCash on manual settlement: config/payments.php
# falls back to the manual gateway when no secret key is set, so the platform
# behaves exactly as it did before rather than failing when someone taps pay.
#
# Use sk_test_ / pk_test_ while developing. An sk_live_ key moves real money.
# Never commit real values — set them in the Render environment.
PAYMONGO_SECRET_KEY=

# Issued when you register the webhook endpoint with PayMongo. This is NOT the
# secret key. Without it the webhook refuses every request, because the
# signature is the only thing distinguishing a real event from a forged one.
PAYMONGO_WEBHOOK_SECRET=
